{%- set php_version_parts = php_version|split('.') -%}
{%- set use_php_lto = php_version_parts[0] > 8 or (php_version_parts[0] == 8 and php_version_parts[1] >= 6) -%}
{%- set use_tailcall_vm = use_php_lto -%}
{%- set drop_memcache = php_version_parts[0] > 8 or (php_version_parts[0] == 8 and php_version_parts[1] >= 5) -%}
{# compile flags #}
{%- set arch_flags = arch == 'x86_64' ? ' -mtls-dialect=gnu2 -m64 -fcf-protection' : '' -%}
{%- if arch == 'x86_64' and os == '10' %} {% set arch_flags = arch_flags ~ ' -march=x86-64-v3' -%} {%- endif -%}
{%- if arch == 'x86_64' and os == '9'  %} {% set arch_flags = arch_flags ~ ' -march=x86-64-v2' -%} {%- endif -%}
{%- if arch == 'x86_64' and os != '10' and os != '9' -%} {%- set arch_flags = arch_flags ~ ' ' -%} {%- endif -%}
{%- set using_gcc = not target -%}
{%- if not using_gcc and not target %}{% set target = 'native-native-gnu' -%}{% endif -%}
{%- set target = target|replace({'native-native': arch ~ '-linux'}) -%}
{%- set specs_cflags = '-specs=/usr/lib/rpm/redhat/redhat-hardened-cc1' -%}
{%- set specs_ldflags = '-specs=/usr/lib/rpm/redhat/redhat-hardened-ld' ~ (os == '10' ? ' -Wl,-z,pack-relative-relocs' : '') -%}
{%- set cflags =
  '-fPIC -O3 -pipe -fno-plt -fno-semantic-interposition -fstack-clash-protection -fno-omit-frame-pointer -momit-leaf-frame-pointer -ffunction-sections -fdata-sections' ~ arch_flags
-%}
{%- set cflags = (using_gcc ? '' : '-flto=thin ') ~ cflags -%}
{%- set php_optimization_flags = not using_gcc or use_php_lto ? ' -flto' : '' -%}
{%- set php_lto_tuning = '' -%}
{# Medium inlining and omitted frame pointers: benchmarks/php86-frankenphp-flags.md. #}
{%- if using_gcc and use_php_lto -%}
    {%- set php_lto_tuning = ' --param=inline-unit-growth=100 --param=ipa-cp-unit-growth=100 --param=large-function-growth=500 --param=max-inline-insns-auto=250 --param=max-inline-insns-single=500 -fomit-frame-pointer' -%}
{%- endif -%}
{# GCC tailcall dispatch is layout-sensitive on Zen 3; see benchmarks/php86-vm-lto-investigation.md. #}
{%- if using_gcc and use_tailcall_vm and arch == 'x86_64' -%}
    {%- set php_lto_tuning = php_lto_tuning ~ ' -falign-functions=64' -%}
{%- endif -%}
{# libtool drops these options from shared links unless explicitly forwarded to the compiler. #}
{%- set php_link_optimization_flags = php_optimization_flags ~ php_lto_tuning|replace({' --param=': ' -Wc,--param=', ' -falign-functions=': ' -Wc,-falign-functions=', ' -fomit-frame-pointer': ' -Wc,-fomit-frame-pointer'}) -%}
{%- set php_optimization_flags = php_optimization_flags ~ php_lto_tuning -%}
{%- if arch == 'aarch64' and using_gcc %}{% set cflags = cflags ~ ' -mtls-size=12' -%}{% endif -%}
{%- set is_rhel = os in ['7', '8', '9', '10'] and type == 'rpm' -%}
{%- if using_gcc and is_rhel -%}
    {%- if os == '7' or os == '8' -%}
        {%- set cflags = cflags ~ ' -Wp,-D_FORTIFY_SOURCE=2' ~ ' ' ~ specs_cflags -%}
    {%- else -%}
        {%- set cflags = cflags ~ ' -Wp,-U_FORTIFY_SOURCE,-D_FORTIFY_SOURCE=3' ~ ' ' ~ specs_cflags -%}
    {%- endif -%}
{%- else %}
    {%- set cflags = cflags ~ ' -D_FORTIFY_SOURCE=3' -%}
{%- endif -%}

{# el8's glibc 2.28 declares copy_file_range, but its 4.18 kernel headers fail php 8.6's
   LINUX_VERSION_CODE >= 5.3 configure gate, so main/io/php_io_copy_linux.c compiles a
   colliding static shim. Presetting the cache var keeps glibc's declaration. #}
{%- set php_configure_vars = (is_rhel and os == '8') ? 'php_cv_func_copy_file_range=yes' : '' -%}
{# On older glibc, libedit satisfies PHP's strlcpy/strlcat link probes but string.h
   does not declare them. Use PHP's bundled implementations. #}
{%- if (is_rhel and os in ['8', '9']) or type == 'deb' -%}
    {%- set php_configure_vars = (php_configure_vars ~ ' ac_cv_func_strlcpy=no ac_cv_func_strlcat=no')|trim -%}
{%- endif -%}
{# PHP 8.6's AArch64 probe falsely rejects GCC 16's working preserve_none ABI. #}
{%- if using_gcc and arch == 'aarch64' and php_version_parts[0] == 8 and php_version_parts[1] == 6 -%}
    {%- set php_configure_vars = php_configure_vars ? php_configure_vars ~ ' php_cv_preserve_none=yes' : 'php_cv_preserve_none=yes' -%}
{%- endif -%}

{# extensions #}
{%- set base_sapi_str = 'cli,cgi,fpm,embed,frankenphp' -%}
{%- set base_extensions_str = 'calendar,ctype,curl,dom,exif,fileinfo,filter,iconv,libxml,mbregex,mbstring,opcache,openssl,password-argon2,pcntl,phar,posix,readline,session,simplexml,sockets,sodium,tokenizer,xml,xmlreader,xmlwriter,zlib' -%}
{%- set base_shared_str = 'amqp,apcu,ast,bcmath,brotli,bz2,clickhouse,dba,decimal,deepclone,dio,ds,ev,event,excimer,fastchart,fastjson,ffi,ftp,gd,gearman,gettext,gmp,gmssl,grpc,igbinary,imagick,inotify,intl,ldap,lz4,maxminddb,memcache,memcached,mongodb,msgpack,mysqli,mysqlnd,mysqlnd_ed25519,mysqlnd_parsec,odbc,opentelemetry,parallel,pcov,pdo,pdo_mysql,pdo_odbc,pdo_pgsql,pdo_sqlite,pdo_sqlsrv,pgsql,protobuf,rar,redis,rdkafka,shmop,simdjson,snappy,soap,spx,sqlite3,sqlsrv,ssh2,swoole,swoole-hook-mysql,swoole-hook-pgsql,swoole-hook-sqlite,swoole-hook-odbc,sysvmsg,sysvsem,sysvshm,tidy,trader,uuid,uv,xdebug,xhprof,xlswriter,xsl,xz,yac,yaml,zip,zstd' -%}

{%- set base_extensions = base_extensions_str|split(',')|map(v => v|trim) -%}
{%- set base_shared = base_shared_str|split(',')|map(v => v|trim) -%}
{%- set base_shared = drop_memcache ? base_shared|filter(v => v != 'memcache') : base_shared -%}
{%- set base_sapi = base_sapi_str|split(',')|map(v => v|trim) -%}

{# Apply optional filtering #}
{%- if filter_packages is defined and filter_packages -%}
{%-   set sapi_list = base_sapi|filter(v => v in filter_packages) -%}
{%-   if 'cli' not in sapi_list -%}
{%-     set sapi_list = ['cli']|merge(sapi_list) -%}
{%-   endif -%}
{%-   set extensions = base_extensions -%}
{%-   set shared_ext = 'devel' in filter_packages ? base_shared : base_shared|filter(v => v in filter_packages) -%}
{%- else -%}
{%-   set extensions = base_extensions -%}
{%-   set shared_ext = base_shared -%}
{%-   set sapi_list = base_sapi -%}
{%- endif -%}

{# excimer bug when compiling with zig on old OS #}
{%- if (os == '8' or type == 'deb') and not using_gcc -%}
{%-   set shared_ext = shared_ext|filter(v => v != 'excimer') -%}
{%- endif -%}

php-version: {{ php_source_version }}
extensions: {{ filter_libraries ? '' : extensions|join(',') }}
shared-extensions: {{ filter_libraries ? '' : shared_ext|join(',') }}
{# craft's libs-only stage only resolves extensions, not sapi targets — list frankenphp's suggests explicitly #}
libs: {{ filter_libraries ? '[' ~ filter_libraries|join(', ') ~ ']' : ('frankenphp' in sapi_list ? '[brotli, watcher]' : '[]') }}
sapi: {{ filter_libraries ? '' : sapi_list|join(',') }}
debug: false
build-options:
    enable-zts: true
    with-suggests: true
    with-shared-libs: true
    with-shared-libdir: '{{ shared_libdir }}'
    no-strip: false
    with-added-patch: ['{{ patch_file }}']
    with-config-file-path: '/etc/{{ prefix }}'
    with-config-file-scan-dir: '/etc/{{ prefix }}/conf.d'
    with-sysconfdir: '/etc/{{ prefix }}'
    # Hardcoded INI options for cli and micro SAPI (e.g. "memory_limit=4G", list accepted)
    with-hardcoded-ini: [ ]
    # UPX pack the binary (default: false)
    with-upx-pack: false
    # Maintainer-only: skip PHP buildconf/configure/make when libphp.a/.so already exist.
    # Frankenphp + shared extensions still rebuild. Flip to true to iterate on frankenphp.
    maintainer-skip-build: false
{% if allow_shared_ext_failure %}    # Pre-release PHP only: skip a shared extension that fails to build or load instead of
    # aborting the run, and record it in buildroot/skipped-shared-extensions.json.
    allow-shared-ext-failure: true
{% endif %}

download-options:
    prefer-pre-built: false
    no-alt: false
    shallow-clone: true
    retry: 5
    parallel: 5
    ignore-cache-sources: '{{ ci ? 'php-src' : '' }}'
{% if php_version >= '8.6' %}
    custom-git:
        - 'ext-apcu:master:https://github.com/krakjoe/apcu.git'
        - 'ext-ast:master:https://github.com/nikic/php-ast.git'
        - 'ext-memcached:master:https://github.com/php-memcached-dev/php-memcached.git'
        - 'ext-xdebug:3.6.0alpha1:https://github.com/xdebug/xdebug.git'
{% endif %}
craft-options:
    doctor: true
    download: true
    build: true

extra-env:
    {% if using_gcc -%}
    SPC_TOOLCHAIN: 'StaticPHP\Toolchain\GccNativeToolchain'
    SPC_LIBC: '{{ type == 'apk' ? 'musl' : 'glibc' }}'
    SPC_MUSL_DYNAMIC: 'true'
    {% else -%}
    SPC_TARGET: '{{ target }}'
    {% endif -%}
    {% if php_configure_vars -%}
    SPC_EXTRA_PHP_VARS: '{{ php_configure_vars }}'
    {% endif -%}
    EXTENSION_DIR: "{{ moduledir }}"
    SPC_CMD_VAR_PHP_EMBED_TYPE: 'shared'
    SPC_MICRO_PATCHES:
    SPC_DEFAULT_CFLAGS: "{{ cflags }}"
    SPC_DEFAULT_CXXFLAGS: "{{ cflags }} -fasynchronous-unwind-tables"
    SPC_DEFAULT_LDFLAGS: "-Wl,-z,relro -Wl,--as-needed -Wl,-z,now -Wl,-z,noexecstack -Wl,--gc-sections {{ using_gcc and is_rhel ? specs_ldflags : '' }}{{ not using_gcc ? ' -flto=thin' : '' }}"
    SPC_CMD_VAR_PHP_MAKE_EXTRA_CFLAGS: "{{ cflags }} -g -fno-math-errno -fPIE{{ php_optimization_flags }}"
    SPC_CMD_VAR_PHP_MAKE_EXTRA_CFLAGS_LIBPHP: "-ftls-model=initial-exec"
    SPC_CMD_VAR_PHP_MAKE_EXTRA_LDFLAGS: "-Wl,--build-id=sha1 -pie -release {{ release_suffix }}{{ php_link_optimization_flags }}"
{% if type == 'apk' %}    # musl uses this ELF header to size default pthread stacks.
    SPC_CMD_VAR_PHP_MAKE_EXTRA_LDFLAGS_PROGRAM: "-Wl,-z,stack-size=0x80000"
{% endif %}
    # SPC appends LIBPHP to EXTRA_LDFLAGS; the optimization flags above already reach libphp.
    SPC_CMD_VAR_PHP_MAKE_EXTRA_LDFLAGS_LIBPHP: "-Wl,-Bsymbolic-functions -Wc,-ftls-model=initial-exec"
    SPC_CMD_PREFIX_PHP_CONFIGURE: "./configure --prefix= --with-valgrind=no --disable-shared --enable-static --disable-all --disable-cgi --disable-phpdbg --disable-debug --with-pic --enable-rtld-now --enable-re2c-cgoto --disable-rpath{{ use_tailcall_vm ? ' --disable-gcc-global-regs' : '' }}"
    SPC_CMD_VAR_FRANKENPHP_XCADDY_MODULES: "--with github.com/dunglas/frankenphp/caddy --with github.com/dunglas/mercure/caddy --with github.com/dunglas/vulcain/caddy --with github.com/dunglas/caddy-cbrotli --with github.com/baldinof/caddy-supervisor"
    PHP_BUILD_PROVIDER: "Marc Henderkes <pkg@henderkes.com> #StandWithUkraine"
    PHP_BUILD_ARCH: '{{ arch }}'
    {% if is_rhel -%}
    PHP_BUILD_SYSTEM: 'Red Hat Enterprise Linux {{ os }}'
    OPENSSLDIR: '/etc/pki/tls'
    {% endif -%}
