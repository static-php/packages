#!/usr/bin/env python3

import argparse
import os
import re
import sys
import glob
import yaml
from datetime import datetime, timezone
from collections import defaultdict

yaml.Dumper.ignore_aliases = lambda *args: True

# Published for opt-in only, never as the stream dnf installs unasked. Users pick it up with
# `dnf module switch-to php-zts:static-8.6`. Drop the entry once the stream goes GA.
PRERELEASE_STREAMS = {"8.6"}

def detect_platform():
    cwd = os.getcwd()
    for p in ['el7', 'el8', 'el9', 'el10']:
        if p in cwd:
            return p
    return None

def detect_arch():
    cwd = os.getcwd()
    for a in ['x86_64', 'aarch64', 'noarch']:
        if a in cwd:
            return a
    return None

def php_stream(version):
    # Stream from the trailing php tag, which carries the PHP pre-release marker while
    # there is one: '5.1.28_86' and '5.1.28~dev_86~beta1' both belong to stream 8.6.
    tag = re.match(r'\d+', version.split('_')[-1])
    if tag and len(tag.group()) >= 2:
        digits = tag.group()
        return f"{digits[:-1]}.{digits[-1]}"
    return '.'.join(version.split('_')[0].split('.')[:2])

def parse_rpm_info(filename):
    basename = os.path.basename(filename)

    layout = re.fullmatch(r"(php-zts-runtime-layout)-(\d+)-(\d+)\.(x86_64|aarch64|noarch)\.rpm", basename)
    if layout:
        return (*layout.groups(), "libraries")

    match_library = re.fullmatch(r'(?P<name>php-zts-lib-[a-z0-9][a-z0-9+-]*(?:-debuginfo)?)-(?P<version>[0-9][^-]*)-(?P<release>[^.]+(?:\.[^.]+)?)\.(?P<arch>x86_64|aarch64|noarch)\.rpm', basename)
    if match_library:
        return (*match_library.group('name', 'version', 'release', 'arch'), 'libraries')

    # Match standard php-zts RPMs (including debuginfo)
    # Format: php-zts-cli-8.5.1-1.el10.x86_64.rpm or php-zts-cli-debuginfo-8.5.1-1.el10.x86_64.rpm
    # Pre-releases carry a tilde suffix: php-zts-cli-8.6.0~beta1-1.el10.x86_64.rpm
    match_php = re.match(r'(?P<name>php-zts-[^-]+(?:-debuginfo)?)-(?P<version>\d+\.\d+\.\d+(?:~{1,2}[a-z0-9]+)*)-(?P<release>[^.]+(?:\.[^.]+)?)\.(?P<arch>x86_64|aarch64|noarch)\.rpm', basename)
    if match_php:
        name = match_php.group("name")
        version = match_php.group("version")
        release = match_php.group("release")
        arch = match_php.group("arch")
        stream = '.'.join(version.split('.')[:2])
        return name, version, release, arch, stream

    # Match extension packages (including debuginfo)
    # Format: php-zts-apcu-5.1.28_85-1.el10.x86_64.rpm or php-zts-apcu-debuginfo-5.1.28_85-1.el10.x86_64.rpm
    # Built against a pre-release PHP the tag carries its marker: php-zts-apcu-5.1.28_86~beta1-1.el10.x86_64.rpm
    match_ext = re.match(r'(?P<name>php-zts-[^-]+(?:-debuginfo)?)-(?P<version>\d+\.\d+\.\d+(?:~{1,2}[a-z0-9]+)*_\d+(?:\.\d+)?(?:~{1,2}[a-z0-9]+)*(?:\+ext(?:~{1,2}[a-z0-9]+)*)?)-(?P<release>[^.]+(?:\.[^.]+)?)\.(?P<arch>x86_64|aarch64|noarch)\.rpm', basename)
    if match_ext:
        name = match_ext.group("name")
        version = match_ext.group("version")
        release = match_ext.group("release")
        arch = match_ext.group("arch")
        stream = php_stream(version)
        return name, version, release, arch, stream

    # Match pie-zts (including debuginfo)
    # Format: pie-zts-1.3.4_85-7.el10.x86_64.rpm or pie-zts-debuginfo-1.3.4_85-7.el10.x86_64.rpm
    match_pie = re.match(r'(pie-zts(?:-debuginfo)?)-(?P<version>\d+\.\d+\.\d+(?:~{1,2}[a-z0-9]+)*_\d+(?:\.\d+)?(?:~{1,2}[a-z0-9]+)*(?:\+ext(?:~{1,2}[a-z0-9]+)*)?)-(?P<release>[^.]+(?:\.[^.]+)?)\.(?P<arch>x86_64|aarch64|noarch)\.rpm', basename)
    if match_pie:
        name = match_pie.group(1)
        version = match_pie.group("version")
        release = match_pie.group("release")
        arch = match_pie.group("arch")
        stream = php_stream(version)
        return name, version, release, arch, stream

    # Match frankenphp (including debuginfo)
    # Format: frankenphp-1.11.0_85-1.el10.x86_64.rpm or frankenphp-debuginfo-1.11.0_85-1.el10.x86_64.rpm
    match_franken = re.match(r'(frankenphp(?:-debuginfo)?)-(?P<version>\d+\.\d+\.\d+(?:~{1,2}[a-z0-9]+)*_\d+(?:\.\d+)?(?:~{1,2}[a-z0-9]+)*(?:\+ext(?:~{1,2}[a-z0-9]+)*)?)-(?P<release>\d+(?:\.[^.]+)?)\.(?P<arch>x86_64|aarch64|noarch)\.rpm', basename)
    if match_franken:
        name = match_franken.group(1)
        version = match_franken.group("version")
        release = match_franken.group("release")
        arch = match_franken.group("arch")
        stream = php_stream(version)
        return name, version, release, arch, stream

    # Match static-php
    match_static = re.match(r'(static-php)-(?P<version>\d+)-(?P<release>\d+)\.(?P<arch>[^.]+)\.rpm', basename)
    if match_static:
        name = match_static.group(1)
        version = match_static.group("version")
        release = match_static.group("release")
        arch = match_static.group("arch")
        stream = "common"
        return name, version, release, arch, stream

    return None

def next_module_version(previous=0):
    return max(int(datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")), int(previous) + 1)

def build_module_structure(rpm_map, platform, arch, module_version=None, metadata=None):
    documents = []
    timestamp = next_module_version() if module_version is None else int(module_version)
    if not 0 < timestamp < 2 ** 64:
        raise ValueError("Module version must be a positive unsigned 64-bit integer")
    metadata = metadata or {}

    # Collect common artifacts (static-php)
    common_artifacts = []
    if "common" in rpm_map:
        for pkg in rpm_map["common"]:
            info = parse_rpm_info(pkg)
            if info:
                name, version, release, arch, _ = info
                epoch = metadata.get(pkg, {}).get("epoch", "0")
                common_artifacts.append(f"{name}-{epoch}:{version}-{release}.{arch}")

    for stream, pkg_list in sorted(rpm_map.items()):
        if stream in {"common", "libraries"}:
            continue

        artifacts = common_artifacts.copy()

        for pkg in sorted(pkg_list):
            info = parse_rpm_info(pkg)
            if not info:
                continue
            name, version, release, arch, _ = info
            epoch = metadata.get(pkg, {}).get("epoch", "0")
            artifacts.append(f"{name}-{epoch}:{version}-{release}.{arch}")

        doc = {
            'document': 'modulemd',
            'version': 2,
            'data': {
                'name': 'php-zts',
                'stream': f'static-{stream}',
                'version': timestamp,
                'context': 'local',
                'arch': arch,
                'summary': f'PHP {stream} (ZTS) packages',
                'description': f'PHP {stream} (ZTS) with private shared runtime libraries',
                'license': {
                    'module': ['MIT']
                },
                'dependencies': [{
                    'buildrequires': {
                        'platform': [platform]
                    }
                }],
                'artifacts': {
                    'rpms': artifacts
                }
            }
        }
        documents.append(doc)
    return documents

def stream_sort_key(stream):
    # Numeric, so 8.10 outranks 8.9 — a string sort puts it before 8.2.
    return tuple(int(p) if p.isdigit() else -1 for p in stream.split('.'))

def build_defaults_document(default_stream):
    return {
        'document': 'modulemd-defaults',
        'version': 1,
        'data': {
            'module': 'php-zts',
            'stream': f'static-{default_stream}',
            'profiles': {
                'default': []
            }
        }
    }

def module_documents(rpm_files, platform, arch, module_version=None, metadata=None):
    rpm_map = defaultdict(list)
    for rpm in rpm_files:
        info = parse_rpm_info(rpm)
        if info:
            rpm_map[info[-1]].append(rpm)
    documents = build_module_structure(rpm_map, platform, arch, module_version, metadata)
    streams = [s for s in rpm_map if s not in {"common", "libraries"} and s not in PRERELEASE_STREAMS]
    if streams:
        documents.append(build_defaults_document(max(streams, key=stream_sort_key)))
    return documents


def main():
    parser = argparse.ArgumentParser(description="Generate PHP module metadata for the common RPM repository.")
    parser.add_argument("--directory", default=".")
    parser.add_argument("--platform", default=None)
    parser.add_argument("--arch", default=None)
    parser.add_argument("--version", type=int)
    parser.add_argument("--output", default="modules.yaml")
    args = parser.parse_args()
    os.chdir(args.directory)
    previous = 0
    if os.path.isfile(args.output):
        with open(args.output) as source:
            previous = max((int(doc.get("data", {}).get("version", 0)) for doc in yaml.safe_load_all(source) if doc and doc.get("document") == "modulemd"), default=0)
    version = args.version if args.version is not None else next_module_version(previous)
    documents = module_documents(glob.glob("*.rpm"), args.platform or detect_platform() or "el8", args.arch or detect_arch() or "x86_64", version)
    with open(args.output, "w") as output:
        yaml.safe_dump_all(documents, output, sort_keys=False, explicit_start=True, explicit_end=True)
    print(os.path.abspath(args.output))


if __name__ == "__main__":
    main()
