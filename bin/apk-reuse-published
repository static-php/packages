#!/usr/bin/env python3
"""Reuse an identical published APK; advance only changed same-version packages."""

import argparse
import gzip
import hashlib
import json
from pathlib import Path
import re
import runpy
import subprocess
import tarfile
import tempfile
import urllib.error


def sha256(path):
    with Path(path).open('rb') as source:
        return hashlib.file_digest(source, 'sha256').hexdigest() if hasattr(hashlib, 'file_digest') else stream_hash(source)


def stream_hash(source):
    digest = hashlib.sha256()
    for chunk in iter(lambda: source.read(1024 * 1024), b''):
        digest.update(chunk)
    return digest.hexdigest()


def contents(path):
    files, fields = {}, {}
    with gzip.open(path, 'rb') as source, tarfile.open(fileobj=source, mode='r|', ignore_zeros=True) as archive:
        for member in archive:
            name = member.name.removeprefix('./')
            if name.startswith('.SIGN.'):
                continue
            if name == '.PKGINFO':
                for line in archive.extractfile(member).read().decode().splitlines():
                    match = re.fullmatch(r'(\w+)\s*=\s*(.*)', line)
                    if match:
                        fields.setdefault(match[1], []).append(match[2])
                continue
            record = [member.type.decode(), member.mode, member.uid, member.gid, member.linkname,
                      {key: value for key, value in member.pax_headers.items() if key not in ('mtime', 'atime', 'ctime')}]
            if member.isfile():
                content = archive.extractfile(member)
                if name == 'usr/share/php-zts/migration/cutoffs.json':
                    cutoffs = json.load(content)
                    for key in ('candidate_archives', 'published_versions'):
                        cutoffs.pop(key, None)
                    record.append(hashlib.sha256(json.dumps(cutoffs, sort_keys=True).encode()).hexdigest())
                else:
                    record.append(stream_hash(content))
            if name in files and files[name] != record:
                raise RuntimeError('Conflicting archive members: ' + name)
            files[name] = record
    for key in ('pkgname', 'pkgver', 'arch'):
        if len(fields.get(key, [])) != 1:
            raise RuntimeError('Missing or ambiguous APK identity: ' + key)
    name, version, arch = (fields[key][0] for key in ('pkgname', 'pkgver', 'arch'))
    if not re.fullmatch(r'.+-r\d+', version):
        raise RuntimeError('Invalid APK revision: ' + version)
    base = re.sub(r'-debuginfo$', '', name)
    for key in ('builddate', 'datahash', 'size'):
        fields.pop(key, None)
    fields['pkgver'] = [version.rsplit('-r', 1)[0]]
    for key in ('depend', 'provides', 'replaces'):
        fields[key] = sorted(re.sub(r'^(' + re.escape(base) + r'(?:-debuginfo)?[=<>~]+)' + re.escape(version) + r'$', r'\1SELF', value)
                             for value in fields.get(key, []))
    return (name, version, arch), (files, {key: sorted(value) for key, value in fields.items()})


def published_records(manifests, name, stem, arch):
    matches = []
    for manifest in manifests:
        manifest = Path(manifest)
        data = json.loads(manifest.read_text())
        if data.get('type', 'apk') != 'apk':
            continue
        packages = list(data.get('packages', []))
        if not any(package.get('name') == name for package in packages):
            packages += data.get('published_packages', [])
        for consumers in data.get('consumer_versions', {}).values():
            if name in consumers:
                packages.append({'name': name, 'version': consumers[name], 'architecture': data.get('architecture')})
        for package in packages:
            published = package.get('version', '')
            if (package.get('name') != name or package.get('architecture') != arch
                    or not re.fullmatch(re.escape(stem) + r'-r\d+', published)):
                continue
            relative = package.get('path', package.get('archive'))
            checksum = package.get('sha256', package.get('archive_sha256'))
            if not relative and name.endswith('-debuginfo') and package.get('publication_url') and package.get('published_checksum'):
                freezer = runpy.run_path(str(Path(__file__).with_name('freeze-migration-baseline.py')))
                output = manifest.parent / 'reuse-published'
                output.mkdir(exist_ok=True)
                try:
                    with tempfile.TemporaryDirectory(dir=output) as stage:
                        downloaded = freezer['download_package'](package, 'apk', output, Path(stage))
                except (freezer['BaselineDownloadError'], urllib.error.URLError, TimeoutError):
                    matches.append((int(published.rsplit('-r', 1)[1]), None, published))
                    continue
                relative = str(Path('reuse-published') / downloaded['path'])
                checksum = downloaded['sha256']
            if not relative or not checksum:
                matches.append((int(published.rsplit('-r', 1)[1]), None, published))
                continue
            source = (manifest.parent / relative).resolve()
            if not source.is_relative_to(manifest.parent.resolve()) or not source.is_file() or sha256(source) != checksum:
                raise RuntimeError('Published archive checksum/path mismatch: ' + name)
            matches.append((int(published.rsplit('-r', 1)[1]), source, published))
    return matches


def valid_archive(source):
    return source is not None and subprocess.run(['apk', 'verify', '--allow-untrusted', str(source)], capture_output=True).returncode == 0


def select(candidate, manifests, with_debug=False):
    (name, version, arch), fingerprint = contents(candidate)
    stem = version.rsplit('-r', 1)[0]
    matches = published_records(manifests, name, stem, arch)
    if not matches:
        return {'revision': int(version.rsplit('-r', 1)[1])}
    highest = max(item[0] for item in matches)
    if name.endswith('-debuginfo') and highest < int(version.rsplit('-r', 1)[1]):
        return {'revision': int(version.rsplit('-r', 1)[1])}
    for revision, source, published in matches:
        if revision != highest or source is None:
            continue
        try:
            identity, existing = contents(source)
        except (RuntimeError, ValueError, OSError, EOFError, tarfile.TarError):
            continue
        if identity != (name, published, arch):
            continue
        if existing == fingerprint and valid_archive(source):
            if with_debug and not name.endswith('-debuginfo'):
                debug = published_records(manifests, name + '-debuginfo', stem, arch)
                debug_revision = max((item[0] for item in debug), default=-1)
                if debug_revision > revision or (debug_revision == revision and not any(valid_archive(item[1]) for item in debug if item[0] == revision)):
                    highest = max(highest, debug_revision)
                    continue
            return {'revision': revision, 'reuse': str(source)}
    return {'revision': max(highest + 1, int(version.rsplit('-r', 1)[1]))}


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('candidate')
    parser.add_argument('--baseline-manifest', action='append', default=[])
    parser.add_argument('--with-debug', action='store_true')
    args = parser.parse_args()
    print(json.dumps(select(args.candidate, args.baseline_manifest, args.with_debug)))
