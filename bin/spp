#!/usr/bin/env php
<?php

// Define constants
define('BASE_PATH', dirname(__DIR__));
const INI_PATH = BASE_PATH . '/src/ini';
define('DIST_PATH', getenv('SPP_DIST_PATH') ?: BASE_PATH . '/dist');
const DIST_RPM_PATH = DIST_PATH . '/rpm';
const DIST_DEB_PATH = DIST_PATH . '/deb';
const DIST_APK_PATH = DIST_PATH . '/apk';
define('TEMP_DIR', sys_get_temp_dir() . '/spc-packages-' . bin2hex(random_bytes(8)));

// Binary metadata must describe the tools installed in this image, even when
// the source snapshot was produced on another architecture.
$_seed = ($_pkg_root = getenv('PKG_ROOT_PATH')) ? $_pkg_root . '/.cache.json' : null;
$_target = BASE_PATH . '/downloads/.cache.json';
if ($_seed && is_readable($_seed)) {
    $_seed_data = json_decode((string) file_get_contents($_seed), true) ?: [];
    $_target_data = is_readable($_target) ? (json_decode((string) file_get_contents($_target), true) ?: []) : [];
    $_merged = $_target_data + $_seed_data;
    foreach ($_seed_data as $_artifact => $_entry) {
        foreach ($_entry['binary'] ?? [] as $_platform => $_binary) {
            if (!is_string($_binary['extract'] ?? null)) {
                continue;
            }
            $_installed = str_replace('{pkg_root_path}', $_pkg_root, $_binary['extract'] ?? '');
            if (str_starts_with($_installed, $_pkg_root . '/') && is_dir($_installed)) {
                $_binary['cache_type'] = 'local';
                $_binary['dirname'] = $_installed;
                $_merged[$_artifact]['binary'][$_platform] = $_binary;
            }
        }
    }
    if ($_merged !== $_target_data) {
        if (!is_dir(dirname($_target))) {
            mkdir(dirname($_target), 0755, true);
        }
        file_put_contents($_target, json_encode($_merged, JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE));
    }
}
unset($_seed, $_target, $_seed_data, $_target_data, $_merged, $_pkg_root, $_artifact, $_entry, $_platform, $_binary, $_installed);

// Ensure autoloading is set up
$composerLoader = require BASE_PATH . '/vendor/autoload.php';
require_once BASE_PATH . '/src/util/SpcAutoload.php';
\staticphp\util\SpcAutoload::configure($composerLoader);

use staticphp\step\CreatePackages;
use Symfony\Component\Console\Application;
use staticphp\Command\BuildCommand;
use staticphp\Command\PackageCommand;
use staticphp\Command\AllCommand;
use staticphp\Command\TestCommand;

// Create a new Symfony Console Application
$application = new Application('SPC Packages', '1.0.0');
$application->setAutoExit(false);

// Register commands
$application->add(new BuildCommand());
$application->add(new PackageCommand());
$application->add(new AllCommand());
$application->add(new TestCommand());

// Set default command to list commands when no command is specified
$application->setDefaultCommand('list');

$exitCode = 1;
try {
    $exitCode = $application->run();
}
catch (Throwable $e) {
    echo "Error running application: " . $e->getMessage() . "\n";
    echo "Stack trace: " . $e->getTraceAsString() . "\n";
}
finally {
    if (is_dir(TEMP_DIR)) {
        exec('rm -rf ' . escapeshellarg(TEMP_DIR));
    }
}
exit($exitCode);

function setupGithubToken(string $method, string $url, array &$headers): void
{
    $token = getenv('GITHUB_TOKEN');
    if (!$token) {
        logger()->debug('no github token found, skip');
        return;
    }
    if (getenv('GITHUB_USER')) {
        $auth = base64_encode(getenv('GITHUB_USER') . ':' . $token);
        $he = "Authorization: Basic {$auth}";
        if (!in_array($he, $headers)) {
            $headers[] = $he;
        }
        logger()->info("using basic github token for {$method} {$url}");
    }
    else {
        $auth = $token;
        $he = "Authorization: Bearer {$auth}";
        if (!in_array($he, $headers)) {
            $headers[] = $he;
        }
        logger()->info("using bearer github token for {$method} {$url}");
    }
}

function getLibdir(): string
{
    // Use the SPP_TYPE constant set by BaseCommand
    // rpm uses /usr/lib64, deb and apk use /usr/lib
    $type = defined('SPP_TYPE') ? SPP_TYPE : 'rpm';
    return $type === 'rpm' ? '/usr/lib64' : '/usr/lib';
}

function getRuntimeLibdir(): string
{
    return '/usr/lib/php-zts/lib';
}

function getRuntimeModuledir(): string
{
    return '/usr/lib/' . CreatePackages::getPrefix() . '/modules';
}

function getConfdir(): string
{
    // Get the prefix from user-provided parameter (e.g., php-zts, php-zts8.5, php-zts85)
    $prefix = CreatePackages::getPrefix();
    return '/etc/' . $prefix;
}

function getModuledir(): string
{
    // Get the prefix from user-provided parameter
    $prefix = CreatePackages::getPrefix();
    return getLibdir() . '/' . $prefix . '/modules';
}

function getPhpLibdir(): string
{
    // Get the prefix from user-provided parameter
    $prefix = CreatePackages::getPrefix();
    return getLibdir() . '/' . $prefix;
}

function getBinarySuffix(): string
{
    // Get the suffix for binaries from the prefix
    // The prefix is set by the user, e.g., "-zts", "-zts8.5", "-zts85"
    // This returns exactly what was passed as --prefix
    return defined('SPP_PREFIX') ? SPP_PREFIX : '-zts';
}

function getSharedLibrarySuffix(): string
{
    // Get the suffix for shared libraries (.so files)
    // Combines binary suffix with PHP version: e.g., "-zts-85" for PHP 8.5
    $binarySuffix = getBinarySuffix();

    $phpVersion = SPP_PHP_VERSION;
    $versionNoDot = str_replace('.', '', $phpVersion);
    return $binarySuffix . '-' . $versionNoDot;
}

function getVarLibdir(): string
{
    // Get /var/lib/{prefix} path
    $prefix = CreatePackages::getPrefix();
    return '/var/lib/' . $prefix;
}

function getSharedir(): string
{
    // Get /usr/share/{prefix} path
    $prefix = CreatePackages::getPrefix();
    return '/usr/share/' . $prefix;
}
