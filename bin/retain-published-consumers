#!/usr/bin/env python3
"""Stage the existing native runtime/debug pair for a same-revision rebuild."""

import argparse
import json
from pathlib import Path
import runpy
import shutil
import subprocess
import tempfile


TOOLS = Path(__file__).resolve().parent
planner = runpy.run_path(str(TOOLS / 'shared-library-plan'))
freezer = runpy.run_path(str(TOOLS / 'freeze-migration-baseline.py'))


def verify(path, kind):
    command = {'apk': ['apk', 'verify', '--allow-untrusted'], 'rpm': ['rpm', '-K', '--nosignature'],
               'deb': ['dpkg-deb', '--contents']}[kind]
    subprocess.run([*command, str(path)], stdout=subprocess.DEVNULL, check=True)


def published_file(record, kind, root):
    if 'path' not in record:
        root = root / 'reuse-published'
        root.mkdir(exist_ok=True)
        with tempfile.TemporaryDirectory(dir=root) as temporary:
            record = freezer['download_package'](record, kind, root, Path(temporary))
    source = planner['rooted'](root, record['path'])
    if not source.is_file() or planner['file_sha256'](source) != record['sha256']:
        raise RuntimeError('Published archive checksum/path mismatch: ' + record['name'])
    return source


def retain_published(kind, directory, manifest):
    baseline = json.loads(manifest.read_text())
    if baseline.get('type', kind) != kind:
        raise RuntimeError('Frozen baseline has the wrong package format')
    records = {}
    for record in [*baseline.get('published_packages', []), *baseline['packages']]:
        version = record['version']
        if kind == 'rpm':
            version = str(record.get('epoch', '0')) + ':' + version
        records[record['name'], version, record['architecture']] = record

    groups = {}
    for path in sorted(directory.glob('*.' + kind)):
        name, version, arch = planner['archive_identity'](path, kind)
        base = name.removesuffix('-debuginfo')
        if base.startswith('php-zts-lib-') or base == 'php-zts-runtime-layout':
            continue
        groups.setdefault((base, version, arch), []).append((name, path))

    for (base, version, arch), candidates in groups.items():
        originals = {}
        changed = False
        for name, path in candidates:
            record = records.get((name, version, arch))
            if record is None:
                continue
            source = published_file(record, kind, manifest.parent)
            originals[name] = source
            if planner['file_sha256'](source) != planner['file_sha256'](path):
                changed = True
        if not changed:
            continue
        if base not in originals:
            raise RuntimeError('Cannot retain published debuginfo without its runtime: ' + base)
        for name, source in originals.items():
            verify(source, kind)
            if planner['archive_identity'](source, kind) != (name, version, arch):
                raise RuntimeError('Published archive identity differs from its index: ' + name)
        for _, path in candidates:
            verify(path, kind)
        for name, path in candidates:
            if name in originals:
                shutil.copyfile(originals[name], path)
            else:
                path.unlink()
            print(f'Skipped rebuilt {name} {version} ({arch}); keeping the published {base} revision.', flush=True)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('kind', choices=('apk', 'rpm', 'deb'))
    parser.add_argument('directory', type=Path)
    parser.add_argument('baseline', type=Path)
    args = parser.parse_args()
    retain_published(args.kind, args.directory, args.baseline)
