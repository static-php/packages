#!/usr/bin/env python3
"""Stage complete RPM generations and atomically switch a canonical repository."""

import argparse
import contextlib
import ctypes
import errno
import fcntl
import gzip
import hashlib
import http.server
import json
import os
import re
import runpy
import shutil
import subprocess
import tempfile
import urllib.parse
import xml.etree.ElementTree as ET
from pathlib import Path, PurePosixPath

import yaml


ROOT = Path(__file__).resolve().parent
MODULES = runpy.run_path(str(ROOT / "createrepo_static"))
SHARED_PLAN = runpy.run_path(str(ROOT / "shared-library-plan"))
PRIVATE = ("php-zts-", "libphp-zts", "pie-zts", "frankenphp")


def digest(path):
    result = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            result.update(block)
    return result.hexdigest()


def write_json(path, value):
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")


@contextlib.contextmanager
def locked(root):
    root.mkdir(parents=True, exist_ok=True)
    root.chmod(0o755)
    with (root / "publication.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def command(arguments):
    result = subprocess.run([str(arg) for arg in arguments], capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError("Command failed: {}\n{}".format(" ".join(str(arg) for arg in arguments), result.stderr))
    return result.stdout


def rpm_metadata(path, allow_unrecognized=False):
    query = "%{NAME}|%{EPOCH}|%{VERSION}|%{RELEASE}|%{ARCH}"
    values = command(["rpm", "-qp", "--nosignature", "--qf", query, path]).strip().split("|")
    if len(values) != 5:
        raise RuntimeError("Cannot read RPM identity: " + str(path))
    name, epoch, version, release, architecture = values
    epoch = epoch if epoch.isdigit() else "0"
    expected = "{}-{}-{}.{}.rpm".format(name, version, release, architecture)
    if path.name != expected:
        raise RuntimeError("RPM filename disagrees with package header: " + str(path))
    info = MODULES["parse_rpm_info"](path.name)
    if info is None and not allow_unrecognized:
        raise RuntimeError("Unrecognized package in PHP repository: " + path.name)
    result = {"name": name, "epoch": epoch, "version": version, "release": release,
              "architecture": architecture, "stream": info[-1] if info else "external", "sha256": digest(path)}
    for kind, prefix in (("requires", "REQUIRE"), ("provides", "PROVIDE")):
        query = "[%{" + prefix + "NAME}\t%{" + prefix + "FLAGS}\t%{" + prefix + "VERSION}\n]"
        result[kind] = []
        for line in command(["rpm", "-qp", "--nosignature", "--qf", query, path]).splitlines():
            fields = line.split("\t")
            if len(fields) != 3:
                raise RuntimeError("Cannot read RPM dependency: " + path.name)
            result[kind].append({"name": fields[0], "flags": int(fields[1]), "version": fields[2]})
    return result


def native_compare(left, right):
    result = subprocess.run(["rpmdev-vercmp", left, right], capture_output=True, text=True)
    if result.returncode not in (0, 11, 12):
        raise RuntimeError("Cannot compare RPM versions: " + result.stderr)
    return {0: 0, 11: 1, 12: -1}[result.returncode]


def dependency_matches(requirement, provider):
    if requirement["name"] != provider["name"]:
        return False
    sense = requirement["flags"] & 14
    if not sense:
        return True
    if not provider["version"]:
        return False
    comparison = native_compare(provider["version"], requirement["version"])
    return bool((comparison < 0 and sense & 2) or (comparison > 0 and sense & 4) or (comparison == 0 and sense & 8))


def validate_private_dependencies(packages):
    for filename, package in packages.items():
        for requirement in package["requires"]:
            if not requirement["name"].startswith(PRIVATE):
                continue
            candidates = [other for other in packages.values()
                          if other["architecture"] in (package["architecture"], "noarch")
                          and (other["stream"] in ("libraries", "common") or other["stream"] == package["stream"])]
            if not any(dependency_matches(requirement, provided) for other in candidates for provided in other["provides"]):
                raise RuntimeError("Incomplete repository: {} requires {} {}".format(filename, requirement["name"], requirement["version"]))


def relative_file(root, location):
    relative = PurePosixPath(location)
    if relative.is_absolute() or ".." in relative.parts or ":" in location:
        raise RuntimeError("Invalid repository location: " + location)
    return root.joinpath(*relative.parts)


def previous_module_version(repository):
    version = 0
    source = repository / "modules.yaml"
    repomd = repository / "repodata/repomd.xml"
    if not source.is_file() and repomd.is_file():
        xml = ET.fromstring(repomd.read_bytes())
        namespace = "{http://linux.duke.edu/metadata/repo}"
        location = xml.find(namespace + "data[@type='modules']/" + namespace + "location")
        if location is not None:
            source = relative_file(repository, location.attrib["href"])
    if source.is_file():
        data = source.read_bytes()
        if data.startswith(b"\x1f\x8b"):
            data = gzip.decompress(data)
        for doc in yaml.safe_load_all(data):
            if doc and doc.get("document") == "modulemd":
                version = max(version, int(doc["data"]["version"]))
    return version


def validate_cohort(incoming, receipt):
    value = json.loads(receipt.read_text())
    if value.get("schema") != 1 or not isinstance(value.get("files"), list) or not value.get("plan_fingerprint"):
        raise RuntimeError("A verified shared-library cohort receipt is required")
    expected = {}
    for item in value["files"]:
        name = Path(item["path"]).name
        if name in expected and expected[name] != item["sha256"]:
            raise RuntimeError("Conflicting cohort filenames: " + name)
        expected[name] = item["sha256"]
    actual = {path.name: digest(path) for path in incoming}
    if expected != actual:
        raise RuntimeError("Incoming RPMs differ from the verified cohort receipt")
    return value


def verify_generation(path):
    manifest = json.loads((path / "generation.json").read_text())
    if manifest.get("schema") != 1 or manifest.get("architecture") not in ("x86_64", "aarch64"):
        raise RuntimeError("Invalid repository generation manifest")
    files = {str(file.relative_to(path)): digest(file) for file in path.rglob("*")
             if file.is_file() and file.name != "generation.json"}
    if files != manifest.get("files"):
        raise RuntimeError("Repository generation changed after validation")
    packages = {file.name: rpm_metadata(file, True) for file in path.glob("*.rpm")}
    if packages != manifest.get("packages"):
        raise RuntimeError("RPM headers changed after validation")
    validate_private_dependencies(packages)
    verify_repodata(path)
    return manifest


def verify_repodata(path):
    namespace = "{http://linux.duke.edu/metadata/repo}"
    root = ET.fromstring((path / "repodata/repomd.xml").read_bytes())
    types = set()
    for entry in root.findall(namespace + "data"):
        types.add(entry.attrib["type"])
        location = relative_file(path, entry.find(namespace + "location").attrib["href"])
        checksum = entry.find(namespace + "checksum")
        if checksum.attrib["type"] not in ("sha256", "sha512", "sha"):
            raise RuntimeError("Unsupported metadata checksum")
        algorithm = "sha1" if checksum.attrib["type"] == "sha" else checksum.attrib["type"]
        if hashlib.new(algorithm, location.read_bytes()).hexdigest() != checksum.text:
            raise RuntimeError("Invalid repository metadata checksum: " + str(location))
    if not {"primary", "modules"}.issubset(types):
        raise RuntimeError("Repository generation lacks primary or module metadata")


def consumer_index(sources, packages, architecture, previous=None):
    inherited = {}
    if previous and (previous / 'shared-library-consumers.json').is_file():
        inherited = json.loads((previous / 'shared-library-consumers.json').read_text()).get('packages', {})
    records = {}
    for filename, package in packages.items():
        if package['stream'] not in ('8.2', '8.3', '8.4', '8.5', '8.6') or package['name'].endswith('-debuginfo'):
            continue
        old = inherited.get(filename)
        if old and old.get('sha256') == package['sha256']:
            records[filename] = old
            continue
        shared = any(item['name'] == 'php-zts-runtime-layout' for item in package['requires'])
        metadata, cutoffs = None, None
        if shared:
            path = sources[filename]
            metadata = SHARED_PLAN['archive_runtime_json'](path, 'rpm', 'usr/share/php-zts/consumers/' + package['name'] + '.json')
            SHARED_PLAN['consumer_dependencies'](metadata, package['name'], package['stream'], package['architecture'])
            if package['name'] == 'php-zts-cli':
                cutoffs = SHARED_PLAN['archive_migration_cutoffs'](path, 'rpm')
        records[filename] = {'name': package['name'], 'version': '{epoch}:{version}-{release}'.format(**package),
                             'arch': package['architecture'], 'sha256': package['sha256'],
                             'consumer_metadata': metadata, 'migration_cutoffs': cutoffs}
    return {'schema': 1, 'type': 'rpm', 'architecture': architecture, 'packages': records}


def stage(args):
    root = args.state_root.resolve()
    incoming = sorted(args.incoming.glob("*.rpm"))
    if not incoming:
        raise RuntimeError("No incoming RPMs")
    receipt = validate_cohort(incoming, args.cohort_receipt)
    with locked(root):
        previous = root / "current"
        prior_manifest = verify_generation(previous) if previous.is_dir() else None
        if prior_manifest and prior_manifest["architecture"] != args.architecture:
            raise RuntimeError("Repository architecture changed")
        sources = {file.name: file for file in previous.glob("*.rpm")} if prior_manifest else {}
        metadata = {name: rpm_metadata(file, True) for name, file in sources.items()}
        if not prior_manifest:
            seed = next((path for path in args.legacy_root if path.name == "el8" and (path / "repodata/repomd.xml").is_file()), None)
            for file in sorted(seed.glob("*.rpm")) if seed else []:
                package = rpm_metadata(file, True)
                if package["architecture"] not in (args.architecture, "noarch"):
                    continue
                identity = tuple(package[field] for field in ("name", "architecture", "stream"))
                previous_name = next((name for name, item in metadata.items()
                                      if identity == tuple(item[field] for field in ("name", "architecture", "stream"))), None)
                if previous_name:
                    order = native_compare("{epoch}:{version}-{release}".format(**package), "{epoch}:{version}-{release}".format(**metadata[previous_name]))
                    if order <= 0:
                        continue
                    del sources[previous_name]
                    del metadata[previous_name]
                sources[file.name] = file
                metadata[file.name] = package
        candidates = {file.name: rpm_metadata(file) for file in incoming}
        if any(item["architecture"] not in (args.architecture, "noarch") for item in candidates.values()):
            raise RuntimeError("RPM architecture differs from canonical repository")
        for name, candidate in candidates.items():
            identity = tuple(candidate[field] for field in ("name", "architecture", "stream"))
            for old_name, old in list(metadata.items()):
                if identity != tuple(old[field] for field in ("name", "architecture", "stream")):
                    continue
                old_evr = "{epoch}:{version}-{release}".format(**old)
                new_evr = "{epoch}:{version}-{release}".format(**candidate)
                order = native_compare(new_evr, old_evr)
                if order < 0 or (order == 0 and candidate["sha256"] != old["sha256"]):
                    raise RuntimeError("Candidate would downgrade or replace the same NEVRA: " + name)
                del sources[old_name]
                del metadata[old_name]
            sources[name] = next(file for file in incoming if file.name == name)
            metadata[name] = candidate
        validate_private_dependencies(metadata)
        maximum = max([int(prior_manifest["module_version"]) if prior_manifest else 0]
                      + [previous_module_version(path) for path in args.legacy_root])
        state = root / "module-version"
        if state.exists():
            maximum = max(maximum, int(state.read_text()))
        version = MODULES["next_module_version"](maximum)
        staging = root / "staging"
        staging.mkdir(exist_ok=True)
        with tempfile.TemporaryDirectory(prefix="generation-", dir=staging) as temporary:
            temporary = Path(temporary)
            for name, source in sources.items():
                if prior_manifest and source.parent == previous:
                    hardlink_or_copy(source, temporary / name)
                else:
                    shutil.copy2(source, temporary / name)
                command(["rpm", "--checksig", "--nosignature", temporary / name])
            index = consumer_index(sources, metadata, args.architecture, previous if prior_manifest else None)
            write_json(temporary / 'shared-library-consumers.json', index)
            documents = MODULES["module_documents"](sorted(sources), "el8", args.architecture, version, metadata)
            with (temporary / "modules.yaml").open("w") as output:
                yaml.safe_dump_all(documents, output, sort_keys=False, explicit_start=True, explicit_end=True)
            command(["createrepo_c", "--checksum", "sha256", temporary])
            command(["modifyrepo_c", "--mdtype=modules", temporary / "modules.yaml", temporary / "repodata"])
            command(["modifyrepo_c", "--mdtype=php-zts-consumers", temporary / "shared-library-consumers.json", temporary / "repodata"])
            verify_repodata(temporary)
            temporary.chmod(0o755)
            for file in temporary.rglob("*"):
                file.chmod(0o755 if file.is_dir() else 0o644)
            files = {str(file.relative_to(temporary)): digest(file) for file in temporary.rglob("*") if file.is_file()}
            generation_id = "{}-{}".format(version, hashlib.sha256(json.dumps(files, sort_keys=True).encode()).hexdigest()[:16])
            manifest = {"schema": 1, "generation": generation_id, "architecture": args.architecture,
                        "module_version": version, "cohort_plan_fingerprint": receipt["plan_fingerprint"],
                        "files": files, "packages": metadata}
            write_json(temporary / "generation.json", manifest)
            (temporary / "generation.json").chmod(0o644)
            verify_generation(temporary)
            destination = root / "generations" / generation_id
            destination.parent.mkdir(exist_ok=True)
            os.rename(temporary, destination)
            temporary.mkdir()
            state.write_text(str(version) + "\n")
        result = {"schema": 1, "generation": str(destination), "module_version": version,
                  "manifest_sha256": digest(destination / "generation.json"), "promoted": False}
        if args.output:
            write_json(args.output, result)
        print(json.dumps(result))


def retain_file(source, destination):
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.exists():
        if digest(source) != digest(destination):
            raise RuntimeError("Historical repository path has conflicting bytes: " + str(destination))
    else:
        hardlink_or_copy(source, destination)
        destination.chmod(0o644)


def hardlink_or_copy(source, destination):
    destination.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.link(source.resolve(), destination)
    except OSError as error:
        if error.errno not in (errno.EXDEV, errno.EPERM, errno.EOPNOTSUPP):
            raise
        shutil.copy2(source, destination)


def publication_views(root, generation, manifest):
    destination = root / "views" / manifest["generation"]
    if destination.is_dir():
        existing = json.loads((destination / "view.json").read_text())
        if existing.get("generation") != manifest["generation"]:
            raise RuntimeError("Publication view identity changed")
        for platform in ("el8", "el9", "el10"):
            if digest(destination / platform / "repodata/repomd.xml") != digest(generation / "repodata/repomd.xml"):
                raise RuntimeError("Publication view metadata changed")
        return destination
    destination.parent.mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="view-", dir=destination.parent) as temporary:
        temporary = Path(temporary)
        counts = {}
        for platform in ("el8", "el9", "el10"):
            sources = {}
            for source_root in (root / "files", root.parent / platform, generation):
                for source in source_root.rglob("*") if source_root.is_dir() else []:
                    if source.is_file():
                        relative = source.relative_to(source_root)
                        if relative == Path("generation.json"):
                            continue
                        sources[relative] = source
            for relative, source in sources.items():
                hardlink_or_copy(source, temporary / platform / relative)
            counts[platform] = len(sources)
        write_json(temporary / "view.json", {"schema": 1, "generation": manifest["generation"], "files_per_prefix": counts})
        temporary.chmod(0o755)
        for directory in temporary.rglob("*"):
            if directory.is_dir():
                directory.chmod(0o755)
        os.rename(temporary, destination)
        temporary.mkdir()
    return destination


def exchange(left, right):
    library = ctypes.CDLL(None, use_errno=True)
    rename = getattr(library, "renameat2", None)
    if rename is None:
        raise RuntimeError("Atomic repository cutover requires Linux renameat2")
    rename.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
    rename.restype = ctypes.c_int
    if rename(-100, os.fsencode(left), -100, os.fsencode(right), 2):
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error), str(right))


def activate_aliases(root, generation, manifest):
    if root.name != ".php-zts" or root.parent.name != manifest["architecture"]:
        raise RuntimeError("Alias activation requires <architecture>/.php-zts as the state root")
    views = publication_views(root, generation, manifest)
    # Check exchange support before replacing any public directory.
    with tempfile.TemporaryDirectory(prefix="exchange-", dir=root) as temporary:
        temporary = Path(temporary)
        (temporary / "directory").mkdir()
        (temporary / "link").symlink_to("directory")
        exchange(temporary / "link", temporary / "directory")
    pointer = root / ".served-next"
    if pointer.is_symlink():
        pointer.unlink()
    pointer.symlink_to(views.relative_to(root), target_is_directory=True)
    os.replace(pointer, root / "served")
    for platform in ("el8", "el9", "el10"):
        public = root.parent / platform
        expected = ".php-zts/served/" + platform
        pending = root.parent / ("." + platform + "-cutover-" + manifest["generation"])
        history = root / "legacy" / manifest["generation"] / platform
        if public.is_symlink() and os.readlink(public) == expected:
            if pending.exists() or pending.is_symlink():
                history.parent.mkdir(parents=True, exist_ok=True)
                os.rename(pending, history)
            continue
        if pending.exists() or pending.is_symlink() or history.exists() or history.is_symlink():
            raise RuntimeError("Unresolved earlier alias cutover: " + str(pending))
        pending.symlink_to(expected, target_is_directory=True)
        if public.exists() or public.is_symlink():
            exchange(pending, public)
            history.parent.mkdir(parents=True, exist_ok=True)
            os.rename(pending, history)
        else:
            os.replace(pending, public)


def promote(args):
    root = args.state_root.resolve()
    generation = args.generation.resolve()
    if generation.parent != root / "generations":
        raise RuntimeError("Generation is not owned by this repository")
    with locked(root):
        manifest = verify_generation(generation)
        current = root / "current"
        if current.is_dir():
            old = verify_generation(current)
            if old["generation"] != manifest["generation"] and int(manifest["module_version"]) <= int(old["module_version"]):
                raise RuntimeError("Module publication version did not advance")
            # The current manifest may have advanced since this generation was staged.
            for name, package in old["packages"].items():
                replacement = [other for other in manifest["packages"].values()
                               if tuple(other[key] for key in ("name", "architecture", "stream")) == tuple(package[key] for key in ("name", "architecture", "stream"))]
                if not replacement or any(native_compare("{epoch}:{version}-{release}".format(**other), "{epoch}:{version}-{release}".format(**package)) < 0 for other in replacement):
                    raise RuntimeError("Staged generation is stale: " + name)
        for source in generation.rglob("*"):
            relative = source.relative_to(generation)
            if source.is_file() and (source.name.endswith(".rpm") or relative.parts[0] == "repodata") and source.name != "repomd.xml":
                retain_file(source, root / "files" / relative)
        if getattr(args, "activate_aliases", False):
            activate_aliases(root, generation, manifest)
        pointer = root / ".current-next"
        if pointer.is_symlink():
            pointer.unlink()
        pointer.symlink_to(generation.relative_to(root), target_is_directory=True)
        os.replace(pointer, current)
        print(json.dumps({"schema": 1, "generation": str(generation), "promoted": True,
                          "aliases_activated": bool(getattr(args, "activate_aliases", False))}))


def nginx(args):
    document_root = args.document_root.rstrip("/")
    prefix = args.url_prefix.strip("/")
    if not re.fullmatch(r"/[A-Za-z0-9_./-]+", document_root) or any(part == ".." for part in document_root.split("/")):
        raise RuntimeError("Document root must be an absolute literal path")
    if prefix and not re.fullmatch(r"[A-Za-z0-9_/-]+", prefix):
        raise RuntimeError("Invalid public URL prefix")
    expression = "/" + (re.escape(prefix) + "/" if prefix else "")
    print("location ~ ^" + expression + r"(?<php_repo_arch>x86_64|aarch64)/(?<php_repo_platform>el(?:8|9|10))/(?<php_repo_path>.*)$ {")
    print("    root " + document_root + ";")
    print("    try_files /$php_repo_arch/.php-zts/current/$php_repo_path")
    print("              /$php_repo_arch/$php_repo_platform/$php_repo_path")
    print("              /$php_repo_arch/.php-zts/files/$php_repo_path")
    for platform in ("el8", "el9", "el10"):
        print("              /$php_repo_arch/" + platform + "/$php_repo_path")
    print("              =404;")
    print("}")


def public_file(repository_root, request_path):
    parts = PurePosixPath(urllib.parse.unquote(urllib.parse.urlsplit(request_path).path)).parts
    if len(parts) < 4 or parts[0] != "/" or ".." in parts:
        return None
    arch, platform = parts[1:3]
    if arch not in ("x86_64", "aarch64") or platform not in ("el8", "el9", "el10"):
        return None
    base = repository_root / arch
    relative = Path(*parts[3:])
    locations = [base / ".php-zts/current", base / platform, base / ".php-zts/files"]
    locations.extend(base / name for name in ("el8", "el9", "el10") if name != platform)
    return next((root / relative for root in locations if (root / relative).is_file()), None)


def serve(args):
    class Handler(http.server.SimpleHTTPRequestHandler):
        def translate_path(self, path):
            resolved = public_file(args.repository_root.resolve(), path)
            return str(resolved) if resolved else str(args.repository_root / ".missing-request")

    with http.server.ThreadingHTTPServer((args.bind, args.port), Handler) as server:
        print(json.dumps({"bind": args.bind, "port": server.server_port}), flush=True)
        server.serve_forever()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    command = commands.add_parser("stage")
    command.add_argument("--state-root", type=Path, required=True)
    command.add_argument("--incoming", type=Path, required=True)
    command.add_argument("--architecture", choices=("x86_64", "aarch64"), required=True)
    command.add_argument("--cohort-receipt", type=Path, required=True)
    command.add_argument("--legacy-root", type=Path, action="append", default=[])
    command.add_argument("--output", type=Path)
    command = commands.add_parser("promote")
    command.add_argument("--state-root", type=Path, required=True)
    command.add_argument("--generation", type=Path, required=True)
    command.add_argument("--activate-aliases", action="store_true", help="Atomically expose el8/el9/el10 paths using filesystem views; retain original cached files.")
    command = commands.add_parser("verify")
    command.add_argument("generation", type=Path)
    command = commands.add_parser("nginx")
    command.add_argument("--document-root", default="/mnt/data/rpm")
    command.add_argument("--url-prefix", default="/")
    command = commands.add_parser("serve", help="Serve a local review repository with the same legacy URL fallback.")
    command.add_argument("--repository-root", type=Path, required=True)
    command.add_argument("--bind", default="127.0.0.1")
    command.add_argument("--port", type=int, default=8080)
    args = parser.parse_args()
    if args.command == "stage":
        stage(args)
    elif args.command == "promote":
        promote(args)
    elif args.command == "verify":
        print(json.dumps(verify_generation(args.generation)))
    elif args.command == "nginx":
        nginx(args)
    elif args.command == "serve":
        serve(args)


if __name__ == "__main__":
    main()
