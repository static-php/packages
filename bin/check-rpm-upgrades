#!/usr/bin/env python3

import argparse
import bz2
import gzip
import hashlib
import http.client
import lzma
import re
import shlex
import subprocess
import sys
import time
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path, PurePosixPath


class PackageDowngradeError(RuntimeError):
    pass


def read_http_file(base_url, location, missing_ok=False):
    relative = PurePosixPath(location)
    if relative.is_absolute() or '..' in relative.parts or ':' in location:
        raise RuntimeError('Invalid RPM metadata location: ' + location)
    request = urllib.request.Request(base_url.rstrip('/') + '/' + location,
                                     headers={'User-Agent': 'APT-HTTP/1.3 (2.6.1)'})
    for attempt in range(3):
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                return response.read()
        except urllib.error.HTTPError as error:
            if missing_ok and error.code == 404:
                return None
            if error.code not in (429, 500, 502, 503, 504) or attempt == 2:
                raise RuntimeError('Cannot read published RPM metadata {}: HTTP {}'.format(request.full_url, error.code)) from error
        except (OSError, http.client.IncompleteRead):
            if attempt == 2:
                raise
        time.sleep(attempt + 1)


def php_stream(version):
    if '_' in version:
        tag = re.match(r'\d+', version.rsplit('_', 1)[1])
        if tag:
            digits = tag.group()
            if len(digits) >= 2:
                return '{}.{}'.format(digits[:-1], digits[-1])
    match = re.match(r'\d+\.\d+', version)
    return match.group() if match else None


def read_remote_file(host, directory, location, missing_ok=False):
    relative = PurePosixPath(location)
    if relative.is_absolute() or '..' in relative.parts or ':' in location:
        raise RuntimeError('Invalid RPM metadata location: ' + location)
    path = shlex.quote(str(PurePosixPath(directory) / relative))
    command = 'cat ' + path
    if missing_ok:
        command = 'if test -f {0}; then cat {0}; else exit 44; fi'.format(path)
    result = subprocess.run(['ssh', host, command], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if missing_ok and result.returncode == 44:
        return None
    if result.returncode != 0:
        raise RuntimeError('Cannot read published RPM metadata: ' + result.stderr.decode(errors='replace'))
    return result.stdout


def published_packages(read_file):
    for attempt in range(3):
        data = read_file('repodata/repomd.xml', missing_ok=True)
        if data is None:
            if attempt:
                raise RuntimeError('Published RPM index disappeared during refresh')
            return []
        index = ET.fromstring(data)
        location = index.find('{http://linux.duke.edu/metadata/repo}data[@type="primary"]/{http://linux.duke.edu/metadata/repo}location')
        if location is None:
            raise RuntimeError('Missing primary RPM metadata')
        location = location.attrib['href']
        data = read_file(location, missing_ok=True)
        if data is not None:
            break
        if attempt == 2:
            raise RuntimeError('Published RPM index references missing metadata after 3 reads: ' + location)
        print('RPM metadata changed during publication; refreshing repomd.xml', file=sys.stderr, flush=True)
        time.sleep(attempt + 1)
    if location.endswith('.gz'):
        data = gzip.decompress(data)
    elif location.endswith('.xz'):
        data = lzma.decompress(data)
    elif location.endswith('.bz2'):
        data = bz2.decompress(data)
    elif location.endswith('.zst'):
        data = subprocess.check_output(['zstd', '-dc'], input=data)
    namespace = '{http://linux.duke.edu/metadata/common}'
    rpm_namespace = '{http://linux.duke.edu/metadata/rpm}'
    packages = []
    for package in ET.fromstring(data).findall(namespace + 'package'):
        version = package.find(namespace + 'version').attrib
        checksum = package.find(namespace + 'checksum')
        packages.append({
            'name': package.find(namespace + 'name').text,
            'arch': package.find(namespace + 'arch').text,
            'version': version['ver'],
            'evr': '{}:{}-{}'.format(version.get('epoch', '0'), version['ver'], version['rel']),
            'location': package.find(namespace + 'location').attrib['href'] if package.find(namespace + 'location') is not None else None,
            'checksum': {'type': checksum.attrib.get('type'), 'value': checksum.text} if checksum is not None else None,
            'provides': [entry.attrib['name'] for entry in package.findall(namespace + 'format/' + rpm_namespace + 'provides/' + rpm_namespace + 'entry')],
        })
    return packages


def local_package(path):
    query = '%{NAME}|%{ARCH}|%{EPOCH}|%{VERSION}|%{RELEASE}'
    output = subprocess.check_output(['rpm', '-qp', '--nosignature', '--qf', query, str(path)], universal_newlines=True)
    name, arch, epoch, version, release = output.split('|')
    epoch = epoch if epoch.isdigit() else '0'
    return {'name': name, 'arch': arch, 'version': version, 'evr': '{}:{}-{}'.format(epoch, version, release), 'path': str(path)}


def same_archive(local, remote):
    checksum = remote.get('checksum') or {}
    algorithm = {'sha': 'sha1'}.get(checksum.get('type'), checksum.get('type'))
    if algorithm not in ['sha256', 'sha512', 'sha1', 'md5'] or not checksum.get('value') or not local.get('path'):
        raise PackageDowngradeError('Cannot prove identical bytes for existing RPM {} {}'.format(local['name'], local['evr']))
    digest = hashlib.new(algorithm)
    with open(local['path'], 'rb') as archive:
        for chunk in iter(lambda: archive.read(1024 * 1024), b''):
            digest.update(chunk)
    if digest.hexdigest() != checksum['value']:
        raise PackageDowngradeError('Refusing different bytes for existing RPM {} {}'.format(local['name'], local['evr']))


def verify_package(local, published, stream=None):
    independent = local['name'].startswith('php-zts-lib-') or re.sub(r'-debuginfo$', '', local['name']) == 'php-zts-runtime-layout'
    local_stream = None if independent else php_stream(local['version'])
    if stream is not None and not independent and local_stream != stream:
        raise RuntimeError('Cannot match {} to PHP {}'.format(local['name'], stream))
    for remote in published:
        remote_stream = None if independent else php_stream(remote['version'])
        if (remote['name'], remote['arch'], remote_stream) != (local['name'], local['arch'], local_stream):
            continue
        result = subprocess.run(['rpmdev-vercmp', local['evr'], remote['evr']], stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True)
        if result.returncode == 12:
            raise PackageDowngradeError('Refusing upload: {} {} sorts below published {}'.format(local['name'], local['evr'], remote['evr']))
        if result.returncode not in [0, 11]:
            raise RuntimeError('Cannot compare RPM versions: ' + result.stderr)
        if result.returncode == 0:
            same_archive(local, remote)


def main():
    parser = argparse.ArgumentParser(description='Select RPM packages that do not downgrade existing candidates in their PHP stream.')
    parser.add_argument('--host')
    parser.add_argument('--remote-directory')
    parser.add_argument('--base-url')
    parser.add_argument('--strict-cohort', action='store_true')
    parser.add_argument('--php-version')
    parser.add_argument('--files-from', required=True, type=Path)
    parser.add_argument('directory', type=Path)
    arguments = parser.parse_args()
    if not arguments.base_url and not (arguments.host and arguments.remote_directory):
        parser.error('Provide --base-url or --host and --remote-directory')
    if arguments.remote_directory and not arguments.host:
        parser.error('--remote-directory requires --host')
    published = []
    if arguments.base_url:
        published.extend(published_packages(lambda location, missing_ok=False: read_http_file(arguments.base_url, location, missing_ok)))
    if arguments.remote_directory:
        published.extend(published_packages(lambda location, missing_ok=False: read_remote_file(arguments.host, arguments.remote_directory, location, missing_ok)))
    files = list(arguments.directory.glob('*.rpm'))
    if not files:
        raise RuntimeError('No RPM packages to verify')
    candidates = []
    skipped = {}
    for path in files:
        local = local_package(path)
        key = (re.sub(r'-debuginfo$', '', local['name']), local['arch'], local['evr'])
        candidates.append((path, key))
        try:
            verify_package(local, published, arguments.php_version)
        except PackageDowngradeError as error:
            skipped[key] = str(error)
    allowed = []
    for path, key in candidates:
        if key in skipped:
            print('::warning::Skipping upload of {}: {}'.format(path.name, skipped[key]))
        else:
            allowed.append(path.name)
    if skipped and arguments.strict_cohort:
        allowed = []
    arguments.files_from.write_bytes(b''.join(name.encode() + b'\0' for name in allowed))
    print('Verified upgrade ordering for {} RPM packages; skipped {}.'.format(len(allowed), len(files) - len(allowed)))
    return 3 if skipped else 0


if __name__ == '__main__':
    sys.exit(main())
