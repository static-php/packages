#!/usr/bin/env python3

import argparse
import bz2
import gzip
import lzma
import re
import shlex
import subprocess
import xml.etree.ElementTree as ET
from pathlib import Path, PurePosixPath


def php_stream(version):
    if '_' in version:
        tag = re.match(r'\d+', version.rsplit('_', 1)[1])
        if tag:
            digits = tag.group()
            if len(digits) >= 2:
                return '{}.{}'.format(digits[:-1], digits[-1])
    match = re.match(r'\d+\.\d+', version)
    return match.group() if match else None


def read_remote_file(host, directory, location, missing_ok=False):
    relative = PurePosixPath(location)
    if relative.is_absolute() or '..' in relative.parts or ':' in location:
        raise RuntimeError('Invalid RPM metadata location: ' + location)
    path = shlex.quote(str(PurePosixPath(directory) / relative))
    command = 'cat ' + path
    if missing_ok:
        command = 'if test -f {0}; then cat {0}; else exit 44; fi'.format(path)
    result = subprocess.run(['ssh', host, command], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if missing_ok and result.returncode == 44:
        return None
    if result.returncode != 0:
        raise RuntimeError('Cannot read published RPM metadata: ' + result.stderr.decode(errors='replace'))
    return result.stdout


def published_packages(read_file):
    data = read_file('repodata/repomd.xml', missing_ok=True)
    if data is None:
        return []
    index = ET.fromstring(data)
    location = index.find('{http://linux.duke.edu/metadata/repo}data[@type="primary"]/{http://linux.duke.edu/metadata/repo}location')
    if location is None:
        raise RuntimeError('Missing primary RPM metadata')
    location = location.attrib['href']
    data = read_file(location)
    if location.endswith('.gz'):
        data = gzip.decompress(data)
    elif location.endswith('.xz'):
        data = lzma.decompress(data)
    elif location.endswith('.bz2'):
        data = bz2.decompress(data)
    elif location.endswith('.zst'):
        data = subprocess.check_output(['zstd', '-dc'], input=data)
    namespace = '{http://linux.duke.edu/metadata/common}'
    packages = []
    for package in ET.fromstring(data).findall(namespace + 'package'):
        version = package.find(namespace + 'version').attrib
        packages.append({
            'name': package.find(namespace + 'name').text,
            'arch': package.find(namespace + 'arch').text,
            'version': version['ver'],
            'evr': '{}:{}-{}'.format(version.get('epoch', '0'), version['ver'], version['rel']),
        })
    return packages


def local_package(path):
    query = '%{NAME}|%{ARCH}|%{EPOCH}|%{VERSION}|%{RELEASE}'
    output = subprocess.check_output(['rpm', '-qp', '--nosignature', '--qf', query, str(path)], universal_newlines=True)
    name, arch, epoch, version, release = output.split('|')
    epoch = epoch if epoch.isdigit() else '0'
    return {'name': name, 'arch': arch, 'version': version, 'evr': '{}:{}-{}'.format(epoch, version, release)}


def verify_package(local, published, stream=None):
    local_stream = php_stream(local['version'])
    if stream is not None and local_stream != stream:
        raise RuntimeError('Cannot match {} to PHP {}'.format(local['name'], stream))
    for remote in published:
        if (remote['name'], remote['arch'], php_stream(remote['version'])) != (local['name'], local['arch'], local_stream):
            continue
        result = subprocess.run(['rpmdev-vercmp', local['evr'], remote['evr']], stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True)
        if result.returncode == 12:
            raise RuntimeError('Refusing upload: {} {} sorts below published {}'.format(local['name'], local['evr'], remote['evr']))
        if result.returncode not in [0, 11]:
            raise RuntimeError('Cannot compare RPM versions: ' + result.stderr)


def main():
    parser = argparse.ArgumentParser(description='Refuse an RPM batch that would lose to an existing candidate in its PHP stream.')
    parser.add_argument('--host', required=True)
    parser.add_argument('--remote-directory', required=True)
    parser.add_argument('--php-version', required=True)
    parser.add_argument('directory', type=Path)
    arguments = parser.parse_args()
    published = published_packages(lambda location, missing_ok=False: read_remote_file(arguments.host, arguments.remote_directory, location, missing_ok))
    files = list(arguments.directory.glob('*.rpm'))
    if not files:
        raise RuntimeError('No RPM packages to verify')
    for path in files:
        verify_package(local_package(path), published, arguments.php_version)
    print('Verified upgrade ordering for {} RPM packages.'.format(len(files)))


if __name__ == '__main__':
    main()
