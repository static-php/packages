#!/usr/bin/env php
<?php

declare(strict_types=1);

function patchSpc(string $file, string $original, string $replacement): void
{
    $path = __DIR__ . '/../vendor/crazywhalecc/static-php-cli/src/StaticPHP/' . $file;
    $source = file_get_contents($path);
    if (str_contains($source, $replacement)) {
        return;
    }
    if (substr_count($source, $original) !== 1) {
        throw new RuntimeException("Cannot locate the expected SPC code in $file");
    }
    if (file_put_contents($path, str_replace($original, $replacement, $source)) === false) {
        throw new RuntimeException("Cannot patch SPC file $file");
    }
}

$method = <<<'PHP'
    private function compilerRuntimes(bool $allowUpdate = true): void
    {
PHP;
$replacement = $method . <<<'PHP'

        if (isset($this->manifest['libraries']['gcc-runtime'])) {
            $visited = [];
            $this->verifyRecord('gcc-runtime', $visited);
            return;
        }
PHP;
patchSpc('Util/SharedLibraryManifest.php', $method, $replacement);

$assignment = <<<'PHP'
preg_match('/^' . $key . '\s*=\s*(.*)$/m', $content, $m)
PHP;
patchSpc('Package/PhpExtensionPackage.php', $assignment, str_replace('\s', '[ \t]', $assignment));
